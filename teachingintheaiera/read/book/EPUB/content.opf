    <dc:title id="epub-title-1">Teaching in the AI Era</dc:title>
    <dc:date id="epub-date">2026</dc:date>
    <dc:language>en-GB</dc:language>
    <dc:creator id="epub-creator-1">Muhammad Tayyab Ilyas</dc:creator>
