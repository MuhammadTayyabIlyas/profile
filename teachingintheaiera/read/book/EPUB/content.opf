    <dc:subject id="subject-1">artificial intelligence in education</dc:subject>
    <dc:subject id="subject-2">ChatGPT in the classroom</dc:subject>
    <dc:subject id="subject-3">teachers and AI</dc:subject>
    <dc:subject id="subject-4">assessment and academic integrity</dc:subject>
    <dc:subject id="subject-5">digital competence</dc:subject>
    <dc:subject id="subject-6">DigCompEdu</dc:subject>
